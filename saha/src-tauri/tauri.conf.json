{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Paratoner Saha",
  "version": "1.0.0",
  "identifier": "com.bugragungoz.paratoner.saha",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5310",
    "beforeDevCommand": "npm run saha:dev",
    "beforeBuildCommand": "npm run saha:build"
  },
  "app": {
    "windows": [
      {
        "title": "Keşif",
        "width": 420,
        "height": 860,
        "backgroundColor": "#131110"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "Bugra Gungoz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
