<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Paylaşılan dosyaya geçici okuma izni (yalnızca önbellekteki paylas/ klasörü). Uygulamanın kendi
             FileProvider'ıyla çakışmasın diye ayrı alt sınıf. -->
        <provider
            android:name="com.bugragungoz.paratoner.saha.paylas.PaylasDosyaSaglayici"
            android:authorities="${applicationId}.paylas"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/paylas_yollari" />
        </provider>
    </application>
</manifest>
