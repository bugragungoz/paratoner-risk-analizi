{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": ["tests/referans-motor/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useProje", "useEtkilesim", "useSaha"] }]
  }
}
